{
  "id": "nodebb-plugin-email-code",
  "name": "Email Code Registration",
  "description": "Verify a user's email address with a one-time code before creating their NodeBB account.",
  "version": "0.1.0",
  "compatibility": "^4.15.0",
  "library": "./lib/email-code.js",
  "hooks": [
    {
      "hook": "static:app.load",
      "method": "init"
    },
    {
      "hook": "filter:register.build",
      "method": "addRegistrationFields"
    },
    {
      "hook": "filter:register.check",
      "method": "checkRegistration"
    },
    {
      "hook": "filter:register.complete",
      "method": "completeRegistration"
    }
  ],
  "scripts": [
    "public/lib/verified.js"
  ],
  "templates": "templates",
  "languages": "languages"
}
